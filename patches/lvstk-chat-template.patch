@@ -455,9 +470,38 @@ class HuggingFaceAutoLM(BaseLM):
     def tok_decode(self, tokens: torch.LongTensor) -> List[str]:
         return self.tokenizer.batch_decode(tokens, skip_special_tokens=True)
 
+    def _format_chat_context(self, context: str) -> str:
+        if not self._use_chat_template:
+            return context
+        return self.tokenizer.apply_chat_template(
+            [{"role": "user", "content": context.rstrip()}],
+            tokenize=False,
+            add_generation_prompt=True,
+        )
+
+    def format_request(self, request_type: str, request: tuple) -> tuple:
+        """Return the exact request strings passed to the model."""
+        if not self._use_chat_template:
+            return request
+        if request_type == "loglikelihood":
+            context, continuation = request
+            return self._format_chat_context(context), continuation.lstrip()
+        if request_type == "greedy_until":
+            context, generation_args = request
+            return self._format_chat_context(context), generation_args
+        return request
+
+    def loglikelihood(
+        self, requests: List[Tuple[str, str]]
+    ) -> List[Tuple[float, bool]]:
+        formatted = [self.format_request("loglikelihood", request) for request in requests]
+        return super().loglikelihood(formatted)
+
     def greedy_until(
         self, requests: List[Tuple[str, Union[List[str], str]]]
     ) -> List[str]:
+        requests = [self.format_request("greedy_until", request) for request in requests]
+
         def _collate(x):
             tokens = self.tok_encode(x[0])
             return len(tokens), x[0]
